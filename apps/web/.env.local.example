# Copy to .env.local and fill from Supabase → Project Settings → API
# cp .env.local.example .env.local

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# New dashboard label: "publishable" key. Classic label: "anon" / "public".
# Put the same public client key in both if unsure.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Secret — server only. Not required for basic signup/login in Phase 1.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Used for email confirmation redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Playwright (`npm run test:e2e`). Email + password throwaway, not Google.
# Optional — the suite will sign one up if Confirm email is OFF in Supabase.
# E2E_EMAIL=
# E2E_PASSWORD=
